{
  "name": "@vitest/eslint-plugin",
  "version": "1.6.28",
  "license": "MIT",
  "description": "ESLint plugin for Vitest",
  "repository": {
    "type": "git",
    "url": "vitest-dev/eslint-plugin-vitest"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "eslint plugin",
    "vitest",
    "vitest eslint plugin"
  ],
  "author": "Verite Mugabo <https://veritemugabo.com/>",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@typescript-eslint/scope-manager": "^8.71.2",
    "@typescript-eslint/utils": "^8.71.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@typescript-eslint/rule-tester": "^8.71.2",
    "bumpp": "^12.3.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-config-flat-gitignore": "^2.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-doc-generator": "^3.7.1",
    "eslint-plugin-eslint-plugin": "^7.6.2",
    "eslint-remote-tester": "^4.0.4",
    "eslint-remote-tester-repositories": "^2.0.2",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@typescript-eslint/eslint-plugin": "*",
    "eslint": ">=8.57.0",
    "typescript": ">=6.0.0",
    "vitest": "*"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    },
    "vitest": {
      "optional": true
    },
    "@typescript-eslint/eslint-plugin": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "endOfLine": "auto"
  },
  "scripts": {
    "build": "tsdown --format esm --format cjs",
    "typecheck": "tsc --noEmit",
    "lint": "concurrently --prefixColors auto \"pnpm:lint:*\"",
    "lint:eslint-docs": "pnpm build && eslint-doc-generator --check",
    "lint:js": "eslint",
    "release": "bumpp && pnpm build && pnpm publish",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest",
    "update:chains": "node scripts/chain-permutations.ts",
    "update:rules": "node scripts/export-rules.ts",
    "update:eslint-docs": "pnpm build && eslint-doc-generator"
  }
}